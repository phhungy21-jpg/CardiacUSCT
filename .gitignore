# Data (never commit patient data)
data/
*.nii
*.nii.gz
*.dcm
jwave_test/results/phase4_pilot_dataset/
# Rescaled/smoothed masks + contours derived directly from real ACDC
# patient anatomy (patient001/023) -- same caution as phase4_pilot_dataset,
# even though these are abstracted to a toy domain scale.
jwave_test/results/mri_irregular_ring_*.npz
jwave_test/results/mri_motion_cycle_*.npz

# jwave_ring_tomography: same caution -- ray/timing/amplitude arrays
# derived directly from real ACDC patient anatomy (patient001/023).
# Figures (PNGs) derived from this data are fine to commit, matching
# jwave_test's own precedent; only the raw derived arrays are excluded.
jwave_ring_tomography/results/*.npz

# Colab working notebooks: the packaged zip (and the notebook itself,
# which embeds that same package as base64 to work around a broken
# upload widget) both contain copies of mri_motion_cycle_patient001/023
# -- same real-ACDC-patient-data caution as above, just in a form the
# filename-based rules can't catch (a zip / base64 blob, not a bare
# .npz). Session-local working artifacts, not meant for the repo.
jwave_ring_tomography/notebooks/

# Same caution -- this project's Colab notebooks embed patient023's
# real ACDC ed_mask as base64 (small, 148KB, but still real patient-
# derived segmentation data).
jwave_cylindrical_tomography/notebooks/

# Also excludes the (derived, real-anatomy) 3D medium array this
# project's src/ scripts save into results/ -- same caution as
# jwave_ring_tomography/results/*.npz. The JSON viewer-export files
# embed the same real patient023-derived mesh/point coordinates.
jwave_cylindrical_tomography/results/*.npz
jwave_cylindrical_tomography/results/*viewer_data*.json
# Colab scan outputs dropped at the project root (e.g.
# single_ring_36_multistatic_scan_patient023.npz) -- same patient-derived data.
jwave_cylindrical_tomography/*.npz

# fourier_inverse: any array built from real ACDC anatomy (Phase 4
# cross-check) -- synthetic-only results are fine to commit.
fourier_inverse/results/*patient*.npz
# Colab session dumps (patient023-derived reconstructions/data under generic names)
fourier_inverse/results/colab_session_*/
# Figure that reproduces a published (copyrighted) patient CT image as its left panel
fourier_inverse/results/figures/*chest*

